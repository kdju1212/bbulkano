# Google OAuth — Google Cloud Console에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # 아무 긴 무작위 문자열 (40자 이상 권장)

# AI 분석 (STEP 6) — Groq 무료 API (https://console.groq.com)
GROQ_API_KEY=

# RAW 가공 탭 (선택) — 기본값으로 두면 됨
# PYTHON=python            # 파이썬 실행 명령이 다르면 지정 (예: py, python3, 절대경로)
# RAW_PIPELINES_DIR=../pipelines  # pipelines 폴더가 다른 위치에 있으면 지정

# ── 상태창 (선택) — 설정한 플랫폼만 표에 나타남 ──────────────────
# 계정 목록 형식: "라벨:계정ID,라벨2:계정ID2" (라벨은 화면 표시용 이름)

# 네이버 검색광고 (SA) — 광고시스템 > 도구 > API 사용관리에서 발급
# NAVER_SEARCHAD_API_KEY=
# NAVER_SEARCHAD_API_SECRET=
# NAVER_SEARCHAD_CUSTOMERS=A기업:1234567,B기업:2345678

# 구글 Ads (SA+DA) — MCC 사용 시 GOOGLE_ADS_LOGIN_CUSTOMER_ID에 MCC ID
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_OAUTH_CLIENT_ID=
# GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CUSTOMERS=A기업:1234567890
# GOOGLE_ADS_API_VERSION=v18   # API 버전 만료 시 조정

# 카카오모먼트 (DA) — 카카오 공식대행사 권한 필요
# KAKAO_MOMENT_ACCESS_TOKEN=
# KAKAO_MOMENT_AD_ACCOUNTS=A기업:123456

# 메타 (DA) — 시스템 사용자 토큰 권장 (일반 토큰은 60일 만료)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNTS=A기업:act_1234567890
# META_API_VERSION=v21.0       # API 버전 만료 시 조정
