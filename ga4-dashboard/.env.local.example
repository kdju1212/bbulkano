# Google OAuth — Google Cloud Console에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # 아무 긴 무작위 문자열 (40자 이상 권장)

# AI 분석 (STEP 6) — Groq 무료 API (https://console.groq.com)
GROQ_API_KEY=

# RAW 가공 탭 (선택) — 기본값으로 두면 됨
# PYTHON=python            # 파이썬 실행 명령이 다르면 지정 (예: py, python3, 절대경로)
# RAW_PIPELINES_DIR=../pipelines  # pipelines 폴더가 다른 위치에 있으면 지정
